SECRET_KEY=replace_me

DEBUG=True

ALLOWED_HOSTS=127.0.0.1,localhost

# Database Credentials
DB_ENGINE=django.db.backends.mysql
DB_NAME=db_name_here
DB_USER=user_name_here
DB_PASSWORD=secret_password
DB_HOST=127.0.0.1
DB_PORT=3306


EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend

EMAIL_HOST=host_here
EMAIL_PORT=port_here

EMAIL_HOST_USER=user_email_here
EMAIL_HOST_PASSWORD=password_here

EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

DEFAULT_FROM_EMAIL=user_email_here
SERVER_EMAIL=

EMAIL_VERIFICATION_EXPIRY_HOURS=

FRONTEND_URL=http://localhost:5173

CORS_ALLOWED_ORIGINS=http://localhost:5173

SECURE_TOKEN_BYTES=32

PASSWORD_RESET_TOKEN_EXPIRY_MINUTES=15

PLATFORM_LOGO_URL=replace_me

# Fernet key for encrypting cloud provider credentials at rest.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIALS_ENCRYPTION_KEY=replace_me

# Google Drive OAuth (Phase 2)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/cloud/providers/google_drive/callback/

# Dropbox OAuth (Phase 7)
DROPBOX_OAUTH_APP_KEY=
DROPBOX_OAUTH_APP_SECRET=
DROPBOX_OAUTH_REDIRECT_URI=http://localhost:8000/api/cloud/providers/dropbox/callback/

OAUTH_STATE_EXPIRY_MINUTES=10
CLOUD_OAUTH_SUCCESS_PATH=/cloud/connections/success
CLOUD_OAUTH_ERROR_PATH=/cloud/connections/error

# File operations (Phase 3)
MAX_FILE_UPLOAD_SIZE_BYTES=104857600
FILE_LIST_DEFAULT_PAGE_SIZE=50
FILE_LIST_MAX_PAGE_SIZE=100

# Celery / Redis (Phase 4) — single default queue for now
# If Windows Redis (or another local server) already uses 6379, set REDIS_HOST_PORT
# in Compose and point these URLs at that published port (e.g. 6380).
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/1
CELERY_TASK_ALWAYS_EAGER=False
CELERY_WORKER_HEALTH_TIMEOUT_SECONDS=2

# Transfers (Phase 5)
MAX_TRANSFER_SIZE_BYTES=104857600