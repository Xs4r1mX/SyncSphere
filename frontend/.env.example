VITE_APP_NAME=SyncSphere
VITE_API_BASE_URL=http://localhost:8000/api
VITE_DEBUG=true
VITE_API_TIMEOUT_MS=30000

# Production builds (Vercel) need the public API origin, not localhost.
# Copy .env.production.example and set VITE_API_BASE_URL, or set the same
# keys as Vercel project environment variables (Production + Preview).
